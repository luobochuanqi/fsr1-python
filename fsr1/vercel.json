{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm install && pnpm build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/upscale.py": {
      "maxDuration": 60,
      "excludeFiles": "{serve.py,input/**,output/**,asset/**,web/src/**,web/public/**,web/index.html,web/vite.config.js,web/package.json,node_modules/**,__pycache__/**,.ruff_cache/**}"
    }
  }
}
